# Firebase *web* app config for the `full-wash` project.
# Only iOS and Android apps are registered today -- register a Web app in the Firebase
# console and paste its config values here.
#
# These are not secrets: they identify the project, they do not grant access. Access is
# the `admin` custom claim, which the backend verifies on every request. Never put a
# payment gateway credential in this file -- it is compiled into the public bundle.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=full-wash.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=full-wash
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_SENDER_ID=

# Only used when APP_ENV=local. staging and prod are pinned in app.config.ts.
EXPO_PUBLIC_API_URL=http://localhost:8000
